{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nusuk-keys",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "nusuk-keys.web.id", "custom_domain": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nusuk-keys",
      "database_id": "020a3f72-80d4-4fb1-a352-fbb4923314c5",
      "migrations_dir": "migrations",
    },
  ],
}
